{
  "name": "@dsh-forge/core",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "description": "DSH Forge 可审计发行版基础工具链",
  "type": "commonjs",
  "main": "dist/apps/desktop/electron-main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.7",
    "@dsh-forge/desktop-layer": "workspace:*",
    "@dsh-forge/desktop-plugin": "workspace:*",
    "@dsh-forge/product-base": "workspace:*",
    "pnpm": "11.7.0",
    "yaml": "2.9.0"
  },
  "scripts": {
    "build": "pnpm run build:core && pnpm run build:desktop-plugin",
    "build:core": "tsc -p tsconfig.build.json && tsx scripts/rewrite-emitted-requires.ts",
    "build:desktop-plugin": "tsc -p packages/desktop-plugin/tsconfig.json",
    "test": "pnpm run build && vitest run",
    "test:node": "pnpm run build && node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --config .oxlintrc.json --tsconfig tsconfig.json src apps packages scripts tests",
    "lint:fix": "pnpm run lint -- --fix",
    "format": "prettier --write \"src/**/*.ts\" \"apps/**/*.ts\" \"packages/desktop-plugin/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"apps/**/*.ts\" \"packages/desktop-plugin/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "check:all": "pnpm run check && pnpm run profile:resolve && pnpm run profile:verify && pnpm run catalog:verify && pnpm run docs:check",
    "profile:resolve": "tsx src/cli/index.ts profile:resolve",
    "profile:verify": "tsx src/cli/index.ts profile:verify",
    "package:inspect": "tsx src/cli/index.ts package:inspect",
    "package:smoke": "tsx scripts/smoke-package.ts",
    "package:desktop": "pnpm run build && tsx scripts/package-desktop.ts",
    "package:signing": "tsx scripts/check-signing.ts",
    "acceptance": "tsx scripts/acceptance.ts",
    "catalog:verify": "tsx src/cli/index.ts catalog:verify",
    "release:gate": "tsx src/cli/index.ts release:gate",
    "docs:check": "tsx src/cli/index.ts docs:check",
    "verify": "pnpm run check:all"
  },
  "bin": {
    "dsh-forge": "dist/src/cli/index.js"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/node": "^22.20.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.7",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "3.6.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
