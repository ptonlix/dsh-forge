{
  "name": "@dsh-forge/core",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "description": "DSH Forge 可审计发行版基础工具链",
  "type": "commonjs",
  "main": "dist/apps/desktop/electron-main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.7",
    "@dsh-forge/desktop-layer": "workspace:*",
    "@dsh-forge/desktop-services": "workspace:*",
    "@dsh-forge/desktop-services-local": "workspace:*",
    "@dsh-forge/profile-toolchain": "workspace:*",
    "pnpm": "11.7.0",
    "yaml": "2.9.0"
  },
  "scripts": {
    "dev": "pnpm run build && pnpm exec electron .",
    "build": "pnpm run build:desktop-services && pnpm run build:toolchain && pnpm run build:core",
    "build:toolchain": "pnpm --filter @dsh-forge/profile-toolchain build",
    "build:core": "tsx scripts/clean-build-output.ts dist && tsc -p tsconfig.build.json && tsx scripts/rewrite-emitted-requires.ts",
    "build:desktop-services": "pnpm --filter @dsh-forge/desktop-services build && pnpm --filter @dsh-forge/profile-toolchain build && pnpm --filter @dsh-forge/desktop-services-local build",
    "test:desktop-services-consumer": "pnpm --filter @dsh-forge/desktop-services build && tsc -p tests/fixtures/desktop-services-consumer/tsconfig.json --noEmit",
    "test:desktop-services-local": "pnpm exec vitest run tests/runtime-services.test.ts",
    "test": "pnpm run build && vitest run",
    "test:node": "pnpm run build && node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --config .oxlintrc.json --tsconfig tsconfig.json apps packages tools scripts tests",
    "lint:fix": "pnpm run lint -- --fix",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "check:all": "pnpm run check && pnpm run boundaries:check && pnpm run profile:resolve && pnpm run profile:verify && pnpm run catalog:verify && pnpm run docs:check",
    "profile:resolve": "tsx tools/profile-toolchain/src/cli/index.ts profile:resolve",
    "profile:verify": "tsx tools/profile-toolchain/src/cli/index.ts profile:verify",
    "dump-config": "tsx tools/profile-toolchain/src/cli/index.ts dump-config",
    "package:inspect": "tsx tools/profile-toolchain/src/cli/index.ts package:inspect",
    "package:smoke": "tsx scripts/smoke-package.ts",
    "package:desktop": "pnpm run build && tsx scripts/package-desktop.ts",
    "package:signing": "tsx scripts/check-signing.ts",
    "acceptance": "tsx scripts/acceptance.ts",
    "catalog:verify": "tsx tools/profile-toolchain/src/cli/index.ts catalog:verify",
    "release:gate": "tsx tools/profile-toolchain/src/cli/index.ts release:gate",
    "docs:check": "tsx tools/profile-toolchain/src/cli/index.ts docs:check",
    "boundaries:check": "tsx scripts/check-boundaries.ts",
    "verify": "pnpm run check:all"
  },
  "bin": {
    "dsh-forge": "tools/profile-toolchain/dist/cli/index.js"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.0",
    "@types/semver": "^7.7.1",
    "electron": "43.4.0",
    "electron-builder": "26.15.7",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
