{
  "name": "@dsh-forge/desktop-layer",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "import": "./lib/index.js", "default": "./lib/index.js" },
    "./client": "./lib/client.js",
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "import": "./lib/typert.remote-client.js",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert.remote-client": {
      "types": "./lib/typert.remote-client.d.ts",
      "import": "./lib/typert.remote-client.js",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && esbuild src/client.ts --bundle --format=esm --charset=utf8 --banner:js=\"/* eslint-disable no-var */\" --platform=browser --external:react --external:@deepseek-ai/dsh-client-ui-primitives --outfile=lib/client.js"
  },
  "dependencies": { "@dsh-forge/desktop-services-local": "workspace:*" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-remotes": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-modules": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-alpha.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "^6.0.3"
  },
  "files": ["lib", "cordis.patch.yml"]
}
