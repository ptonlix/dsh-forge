{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsh-forge/distribution@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "packageScope", "applicationId", "version", "defaultProfile", "platforms"],
  "properties": {
    "schema": { "const": "dsh-forge/distribution@1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "name": { "type": "string", "minLength": 1 },
    "packageScope": { "type": "string", "pattern": "^@[a-z0-9._-]+$" },
    "applicationId": { "type": "string", "pattern": "^ai\\.[a-z0-9-]+(?:\\.[a-z0-9-]+)+$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "defaultProfile": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "platforms": { "type": "array", "minItems": 1 },
    "updates": { "type": "object" }
  }
}
